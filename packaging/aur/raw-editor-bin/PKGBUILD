# Maintainer: Ayman Rebai <ryuilight at gmail dot com>
pkgname=raw-editor-bin
pkgver=0.9.26
pkgrel=1
pkgdesc="A native RAW photo editor with a GPU pipeline"
arch=('x86_64')
url="https://github.com/HappySlappyFace/RawEditor"
license=('MIT')
depends=('gcc-libs' 'glibc' 'vulkan-icd-loader' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi')
optdepends=('xdg-desktop-portal: native file and folder pickers')
provides=('raw-editor')
conflicts=('raw-editor')
source=("raw-editor-linux-v${pkgver}.zip::${url}/releases/download/v${pkgver}/raw-editor-linux-v${pkgver}.zip"
        "raw-editor.desktop::https://raw.githubusercontent.com/HappySlappyFace/RawEditor/v${pkgver}/packaging/linux/raw-editor.desktop")
sha256sums=('SKIP'
            'SKIP')

package() {
  cd "${srcdir}/raw-editor-linux"
  install -Dm755 raw-editor "${pkgdir}/usr/bin/raw-editor"
  install -Dm644 assets/icon.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/raw-editor.png"
  install -Dm644 "${srcdir}/raw-editor.desktop" "${pkgdir}/usr/share/applications/raw-editor.desktop"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
